---
const { name, avif, webp, jpg } = Astro.props;
---

<a href="#" class="card">

  <picture>
    <source srcset={avif} type="image/avif" />
    <source srcset={webp} type="image/webp" />
    <img src={jpg} alt={`Bebida energética ${name}`} />
  </picture>

  <div class="info">
    <h3>{name}</h3>
    <p>Siente la velocidad, desata tu poder</p>
  </div>

</a>