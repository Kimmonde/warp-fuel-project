---
import "../styles/global.css";
import ProductCard from "../components/ProductCard.astro";
---

<section class="hero">

  <video
    autoplay
    muted
    loop
    playsinline
    preload="auto"
    poster="/poster.jpg"
  >
    <source src="/hero-video.mp4" type="video/mp4" />
  </video>

  <div class="overlay">

    <h1>WARP FUEL</h1>

    <p>Energy beyond limits.</p>

    <a href="#products" class="cta">
      Explore Products
    </a>

  </div>

</section>

<div class="container" id="products">

  <header class="header">

    <img src="/logo.png" class="logo" alt="Warp Fuel logo" />

    <h2 class="title">OUR PRODUCTS</h2>

  </header>

  <div class="grid">

    <ProductCard
      name="Warp Original"
      avif="/warp1.avif"
      webp="/warp1.webp"
      jpg="/warp1.jpg"
    />

    <ProductCard
      name="Warp Apple"
      avif="/warp2.avif"
      webp="/warp2.webp"
      jpg="/warp2.jpg"
    />

    <ProductCard
      name="Warp Strawberry"
      avif="/warp3.avif"
      webp="/warp3.webp"
      jpg="/warp3.jpg"
    />

  </div>

</div>

<section class="about">

  <img src="/warp2.jpg" alt="Warp Fuel can" />

  <div class="about-text">

    <h2>Maximum Performance</h2>

    <p>
      Warp Fuel is designed for gamers, athletes and creators
      who demand extreme focus and limitless energy.
      Our formula delivers performance, speed and intensity
      in every sip.
    </p>

  </div>

</section>

<section class="parallax">

  <div class="parallax-content">

    <h2>PURE ENERGY EXPERIENCE</h2>

    <p>
      Built for high performance moments. Feel the focus,
      speed and intensity with every sip.
    </p>

  </div>

</section>

<footer>

  <div class="footer-content">

    <div class="footer-column">
      <h3>Warp Fuel</h3>
      <p>Energy beyond limits.</p>
    </div>

    <div class="footer-column">
      <h3>Contact</h3>
      <p>contact@warpfuel.com</p>
      <p>+34 600 000 000</p>
    </div>

    <div class="footer-column">
      <h3>Social Media</h3>

      <a href="#">Instagram</a>
      <a href="#">TikTok</a>
      <a href="#">YouTube</a>
    </div>

  </div>

</footer>